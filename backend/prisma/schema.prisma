  number          String       @unique
  status          String       @default("pending")
  provider        String       @default("manual")
  subtotalHalalas Int          @map("subtotal_halalas")
  vatHalalas      Int          @default(0) @map("vat_halalas")
  totalHalalas    Int          @map("total_halalas")
  periodStart     DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime     @map("period_end") @db.Timestamptz(6)
