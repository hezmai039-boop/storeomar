// Prisma schema — mirrors docs/01-database-design.md exactly (table/column
// names match 1:1 so the design doc stays the single source of truth).
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ------------------------------------------------------------------
// 1. Organizational scope
// ------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stores        Store[]
  users         User[]
  members       OrganizationMember[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  usageCounters UsageCounter[]
  invoices      Invoice[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  timezone       String   @default("Asia/Riyadh")
  currency       String   @default("SAR")
  status         String   @default("active")
  settings       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id])
  userStoreRoles         UserStoreRole[]
  channelAccounts        ChannelAccount[]
  customers              Customer[]
  conversations          Conversation[]
  messages               Message[]
  knowledgeSources       KnowledgeSource[]
  knowledgeChunks        KnowledgeChunk[]
  aiAgent                AiAgent?
  aiSuggestions          AiSuggestedKnowledge[]
  aiResponseLogs         AiResponseLog[]
  ticketDepartments      TicketDepartment[]
  tickets                Ticket[]
  integrations           Integration[]
  syncedOrders           SyncedOrder[]
  syncedProducts         SyncedProduct[]
  dailyMetrics           StoreDailyMetric[]
  auditLogs              AuditLog[]
  aiSpecialists          AiSpecialist[]
  aiToolInvocations      AiToolInvocation[]
  aiOrchestratorRuns     AiOrchestratorRun[]
  aiCustomerMemories     AiCustomerMemory[]
  aiConversationMemories AiConversationMemory[]
  aiBusinessMemories     AiBusinessMemory[]
  simulationLinks        SimulationLink[]

  @@unique([organizationId, slug])
  @@map("stores")
}

// ------------------------------------------------------------------
// 2. Identity, roles & flexible per-store access
// ------------------------------------------------------------------

model User {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  email          String    @unique
  phone          String?
  passwordHash   String    @map("password_hash")
  status         String    @default("active")
  // Platform staff, not tenant staff. `owner` is the top role INSIDE an
  // organization — once clients sign themselves up (phase 3), every client
  // is an owner of their own org, so owner cannot be what authorizes
  // "confirm this bank transfer was actually received": that would let any
  // customer approve their own invoice and run free forever. This flag is
  // the only thing that gates the billing admin routes, and nothing in the
  // API can set it — it is granted by the seed or by hand in the DB.
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization           Organization           @relation(fields: [organizationId], references: [id])
  organizationRoles      OrganizationMember[]
  storeRoles             UserStoreRole[]        @relation("UserStoreRoleUser")
  grantedRoles           UserStoreRole[]        @relation("UserStoreRoleGrantedBy")
  assignedConversations  Conversation[]
  sentMessages           Message[]
  createdSources         KnowledgeSource[]
  reviewedSuggestions    AiSuggestedKnowledge[]
  assignedTickets        Ticket[]
  ticketEvents           TicketEvent[]
  auditLogs              AuditLog[]
  createdSimulationLinks SimulationLink[]
  reviewedInvoices       Invoice[]              @relation("InvoiceReviewer")

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  scope     String // 'organization' | 'store'
  isSystem  Boolean  @default(true) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions     RolePermission[]
  organizationMembers OrganizationMember[]
  userStoreRoles      UserStoreRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  module      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId, roleId])
  @@map("organization_members")
}

model UserStoreRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String   @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User  @relation("UserStoreRoleUser", fields: [userId], references: [id])
  grantedByUser User  @relation("UserStoreRoleGrantedBy", fields: [grantedBy], references: [id])
  store         Store @relation(fields: [storeId], references: [id])
  role          Role  @relation(fields: [roleId], references: [id])

  @@unique([userId, storeId, roleId])
  @@map("user_store_roles")
}

// ------------------------------------------------------------------
// 3. Channels
// ------------------------------------------------------------------

model ChannelType {
  id         String  @id @default(uuid()) @db.Uuid
  key        String  @unique // whatsapp | instagram | messenger | tiktok
  name       String
  adapterKey String  @map("adapter_key")
  isActive   Boolean @default(true) @map("is_active")

  channelAccounts ChannelAccount[]

  @@map("channel_types")
}

model ChannelAccount {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  channelTypeId        String    @map("channel_type_id") @db.Uuid
  externalAccountId    String    @map("external_account_id")
  displayName          String    @map("display_name")
  credentialsEncrypted Bytes     @map("credentials_encrypted")
  webhookVerifyToken   String?   @map("webhook_verify_token")
  status               String    @default("connected")
  connectedAt          DateTime? @map("connected_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store         Store          @relation(fields: [storeId], references: [id])
  channelType   ChannelType    @relation(fields: [channelTypeId], references: [id])
  customers     Customer[]
  conversations Conversation[]

  @@unique([storeId, channelTypeId, externalAccountId])
  @@index([externalAccountId])
  @@map("channel_accounts")
}

// ------------------------------------------------------------------
// 4. Unified inbox: customers, conversations, messages
// ------------------------------------------------------------------

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  channelAccountId String?  @map("channel_account_id") @db.Uuid
  externalId       String   @map("external_id")
  name             String?
  phone            String?
  email            String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store              @relation(fields: [storeId], references: [id])
  channelAccount ChannelAccount?    @relation(fields: [channelAccountId], references: [id])
  conversations  Conversation[]
  tickets        Ticket[]
  aiMemories     AiCustomerMemory[]

  @@unique([storeId, channelAccountId, externalId])
  @@map("customers")
}

model Conversation {
  id                String    @id @default(uuid()) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  channelAccountId  String    @map("channel_account_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  status            String    @default("open")
  assignedUserId    String?   @map("assigned_user_id") @db.Uuid
  aiConfidenceLevel String?   @map("ai_confidence_level")
  lastMessageAt     DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store              Store                  @relation(fields: [storeId], references: [id])
  channelAccount     ChannelAccount         @relation(fields: [channelAccountId], references: [id])
  customer           Customer               @relation(fields: [customerId], references: [id])
  assignedUser       User?                  @relation(fields: [assignedUserId], references: [id])
  messages           Message[]
  suggestions        AiSuggestedKnowledge[]
  responseLogs       AiResponseLog[]
  tickets            Ticket[]
  aiMemory           AiConversationMemory?
  aiOrchestratorRuns AiOrchestratorRun[]
  aiToolInvocations  AiToolInvocation[]

  @@index([storeId, lastMessageAt])
  @@index([storeId, customerId, status])
  @@map("conversations")
}

model Message {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  senderType        String   @map("sender_type") // customer | ai | agent | system
  senderUserId      String?  @map("sender_user_id") @db.Uuid
  content           String
  attachments       Json     @default("[]")
  externalMessageId String?  @map("external_message_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation   @relation(fields: [conversationId], references: [id])
  store        Store          @relation(fields: [storeId], references: [id])
  senderUser   User?          @relation(fields: [senderUserId], references: [id])
  responseLog  AiResponseLog?

  @@index([conversationId, createdAt])
  @@index([storeId])
  @@map("messages")
}

// ------------------------------------------------------------------
// 5. Knowledge base & AI agent
// ------------------------------------------------------------------

model KnowledgeSource {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  type      String // pdf|word|excel|faq|webpage|product|shipping_policy|return_policy|chat_history
  title     String
  fileUrl   String?  @map("file_url")
  rawText   String?  @map("raw_text")
  status    String   @default("processing")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store   Store            @relation(fields: [storeId], references: [id])
  creator User             @relation(fields: [createdBy], references: [id])
  chunks  KnowledgeChunk[]

  @@index([storeId, status])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id        String                       @id @default(uuid()) @db.Uuid
  storeId   String                       @map("store_id") @db.Uuid
  sourceId  String                       @map("source_id") @db.Uuid
  content   String
  embedding Unsupported("vector(1536)")?
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  store  Store           @relation(fields: [storeId], references: [id])
  source KnowledgeSource @relation(fields: [sourceId], references: [id])

  @@index([storeId])
  @@map("knowledge_chunks")
}

model AiAgent {
  id                          String   @id @default(uuid()) @db.Uuid
  storeId                     String   @unique @map("store_id") @db.Uuid
  name                        String
  persona                     Json     @default("{}")
  modelProvider               String   @map("model_provider")
  modelName                   String   @map("model_name")
  confidenceThresholdHigh     Decimal  @default(0.85) @map("confidence_threshold_high") @db.Decimal(3, 2)
  confidenceThresholdLow      Decimal  @default(0.5) @map("confidence_threshold_low") @db.Decimal(3, 2)
  // Opt-in switch for the AI Intelligence Layer (specialists + live tool
  // calls into products/orders/customers) as the reply engine for real
  // customer messages, instead of the classic knowledge-base confidence
  // gate. Defaults to false so no store's per-message AI cost changes
  // unless a manager explicitly turns this on — see aiRouter.ts.
  advancedIntelligenceEnabled Boolean  @default(false) @map("advanced_intelligence_enabled")
  status                      String   @default("active")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@map("ai_agents")
}

model AiSuggestedKnowledge {
  id             String    @id @default(uuid()) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  conversationId String?   @map("conversation_id") @db.Uuid
  content        String
  status         String    @default("pending_review")
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  reviewer     User?         @relation(fields: [reviewedBy], references: [id])

  @@index([storeId, status])
  @@map("ai_suggested_knowledge")
}

model AiResponseLog {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  messageId       String?  @unique @map("message_id") @db.Uuid
  confidenceLevel String   @map("confidence_level")
  actionTaken     String   @map("action_taken")
  // Per-reply provider usage. Nullable because every row written before
  // billing shipped has no usage data, and because a paused/failed reply
  // legitimately consumes nothing — 0 and "unknown" must stay
  // distinguishable when reporting cost per store.
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  costMicroUsd    Int?     @map("cost_micro_usd")
  model           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  message      Message?     @relation(fields: [messageId], references: [id])

  @@index([storeId, actionTaken, createdAt])
  @@map("ai_response_logs")
}

// ------------------------------------------------------------------
// 6. Tickets
// ------------------------------------------------------------------

model TicketDepartment {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  name    String

  store   Store    @relation(fields: [storeId], references: [id])
  tickets Ticket[]

  @@unique([storeId, name])
  @@map("ticket_departments")
}

model Ticket {
  id               String    @id @default(uuid()) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  departmentId     String?   @map("department_id") @db.Uuid
  assignedUserId   String?   @map("assigned_user_id") @db.Uuid
  status           String    @default("open")
  priority         String    @default("medium")
  escalationReason String?   @map("escalation_reason")
  aiRecommendation String?   @map("ai_recommendation")
  attachments      Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)

  store        Store             @relation(fields: [storeId], references: [id])
  conversation Conversation      @relation(fields: [conversationId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  department   TicketDepartment? @relation(fields: [departmentId], references: [id])
  assignedUser User?             @relation(fields: [assignedUserId], references: [id])
  events       TicketEvent[]

  @@index([storeId, status])
  @@map("tickets")
}

model TicketEvent {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  eventType   String   @map("event_type")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  actorUser User?  @relation(fields: [actorUserId], references: [id])

  @@index([ticketId])
  @@map("ticket_events")
}

// ------------------------------------------------------------------
// 7. Store platform integrations
// ------------------------------------------------------------------

model Integration {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  platform             String // salla | zid | shopify | woocommerce
  credentialsEncrypted Bytes     @map("credentials_encrypted")
  status               String    @default("connected")
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store          Store           @relation(fields: [storeId], references: [id])
  syncedOrders   SyncedOrder[]
  syncedProducts SyncedProduct[]

  @@unique([storeId, platform])
  @@map("integrations")
}

model SyncedOrder {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid
  externalOrderId String   @map("external_order_id")
  customerRef     String?  @map("customer_ref")
  status          String
  trackingUrl     String?  @map("tracking_url")
  rawPayload      Json     @default("{}") @map("raw_payload")
  syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  store       Store       @relation(fields: [storeId], references: [id])
  integration Integration @relation(fields: [integrationId], references: [id])

  @@unique([storeId, integrationId, externalOrderId])
  @@index([storeId, customerRef])
  @@map("synced_orders")
}

model SyncedProduct {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  integrationId     String   @map("integration_id") @db.Uuid
  externalProductId String   @map("external_product_id")
  name              String
  price             Decimal? @db.Decimal(10, 2)
  currency          String?
  sizes             Json     @default("[]")
  rawPayload        Json     @default("{}") @map("raw_payload")
  syncedAt          DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  store       Store       @relation(fields: [storeId], references: [id])
  integration Integration @relation(fields: [integrationId], references: [id])

  @@unique([storeId, integrationId, externalProductId])
  @@map("synced_products")
}

// ------------------------------------------------------------------
// 8. Reporting & audit
// ------------------------------------------------------------------

model StoreDailyMetric {
  id                      String   @id @default(uuid()) @db.Uuid
  storeId                 String   @map("store_id") @db.Uuid
  metricDate              DateTime @map("metric_date") @db.Date
  totalConversations      Int      @default(0) @map("total_conversations")
  aiResolvedCount         Int      @default(0) @map("ai_resolved_count")
  escalatedCount          Int      @default(0) @map("escalated_count")
  avgFirstResponseSeconds Int?     @map("avg_first_response_seconds")
  topQuestions            Json     @default("[]") @map("top_questions")
  topIssues               Json     @default("[]") @map("top_issues")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, metricDate])
  @@map("store_daily_metrics")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  storeId        String?  @map("store_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  store        Store?       @relation(fields: [storeId], references: [id])
  actorUser    User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([storeId])
  @@map("audit_logs")
}

// ------------------------------------------------------------------
// 9. AI Intelligence Layer — per-store specialist agents, a tool-calling
// audit trail, an orchestrator run log, and multi-tier memory. Additive
// only: no column on any table above is touched. Every model here carries
// its own store_id and is added to the RLS table list in prisma/rls.sql,
// exactly like every table in sections 1-8. See docs/17-ai-intelligence-
// layer.md for the full design rationale.
// ------------------------------------------------------------------

model AiSpecialist {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  key          String // product | order | customer | shipping | inventory | marketing | knowledge | recommendation | ticket | sales | analytics | supervisor | manager | escalation | workflow | report
  name         String
  systemPrompt String   @map("system_prompt")
  allowedTools Json     @default("[]") @map("allowed_tools") // string[] of tool keys from the code registry (src/modules/ai-intelligence/tools/registry.ts)
  isEnabled    Boolean  @default(true) @map("is_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@map("ai_specialists")
}

model AiToolInvocation {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  specialistKey  String   @map("specialist_key")
  toolKey        String   @map("tool_key")
  arguments      Json     @default("{}")
  result         Json?
  success        Boolean
  errorMessage   String?  @map("error_message")
  latencyMs      Int?     @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store         @relation(fields: [storeId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([storeId])
  @@map("ai_tool_invocations")
}

model AiOrchestratorRun {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  conversationId    String   @map("conversation_id") @db.Uuid
  messageId         String?  @map("message_id") @db.Uuid
  question          String
  classifiedIntent  String?  @map("classified_intent")
  routedSpecialists Json     @default("[]") @map("routed_specialists") // string[] of specialist keys
  confidence        Decimal? @db.Decimal(3, 2)
  escalated         Boolean  @default(false)
  replyText         String?  @map("reply_text")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([storeId])
  @@map("ai_orchestrator_runs")
}

model AiCustomerMemory {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  key        String
  value      Json
  source     String   @default("learned") // learned | manual
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store    @relation(fields: [storeId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([storeId, customerId, key])
  @@map("ai_customer_memory")
}

model AiConversationMemory {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  conversationId String   @unique @map("conversation_id") @db.Uuid
  summary        String?
  keyFacts       Json     @default("[]") @map("key_facts")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store        Store        @relation(fields: [storeId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("ai_conversation_memory")
}

model AiBusinessMemory {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@map("ai_business_memory")
}

// ------------------------------------------------------------------
// 10. Simulation links — shareable, unauthenticated chat links that let
// a store owner test the live AI pipeline (the exact same
// gatherAiContext/completeAiPipeline in modules/knowledge/aiPipeline.ts
// that a real WhatsApp message hits) with real testers, before connecting
// a real channel account. Additive; does not touch channel_accounts'
// existing semantics — see docs/19-simulation-links.md.
// ------------------------------------------------------------------

model SimulationLink {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  token     String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store   Store @relation(fields: [storeId], references: [id])
  creator User  @relation(fields: [createdBy], references: [id])

  @@index([storeId])
  @@map("simulation_links")
}

// ------------------------------------------------------------------
// 11. Billing — plans, subscriptions, usage quotas and invoices.
//
// Scoped to the ORGANIZATION, not the store: a customer buys one
// subscription and it covers every store under their org (an agency
// running 30 client stores pays once, against one message quota). That is
// also why none of these tables appear in prisma/rls.sql — RLS keys off
// `app.accessible_store_ids`, and these rows have no store_id to key on.
// Their isolation comes from the API layer instead: every billing route
// reads req.auth.organizationId, which comes from the signed JWT and can
// never be supplied by the client. See docs/25-billing-and-plans.md.
//
// Payment provider is deliberately abstracted (modules/billing/adapters)
// rather than hard-wired to one gateway — same registry pattern as
// channels/ and integrations/. Ships with the `manual` provider (bank
// transfer + owner confirmation), which needs no commercial registration
// or gateway contract to start collecting real money. Adding Moyasar or
// Tap later is one adapter file plus one line in the registry.
// ------------------------------------------------------------------

model Plan {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique // free | basic | pro
  name     String
  nameEn   String  @map("name_en")
  // Price in HALALAS (SAR × 100). Integer on purpose — floats lose money.
  priceHalalas Int  @map("price_halalas")
  currency String  @default("SAR")
  interval String  @default("monthly") // monthly | yearly
  // Quotas. null = unlimited, so an enterprise plan doesn't need sentinel
  // numbers like 999999 that later read as a bug.
  maxStores        Int? @map("max_stores")
  maxUsers         Int? @map("max_users")
  maxAiRepliesMonthly Int? @map("max_ai_replies_monthly")
  features Json    @default("[]")
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int    @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("plans")
}

model Subscription {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  // trialing | active | past_due | canceled
  status         String   @default("trialing")
  provider       String   @default("manual") // manual | moyasar | tap
  providerRef    String?  @map("provider_ref")
  currentPeriodStart DateTime @default(now()) @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt    DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  canceledAt     DateTime? @map("canceled_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model UsageCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // First day of the billing month, "YYYY-MM" — cheap to compute, cheap to
  // index, and makes "this month's usage" a single unique lookup instead of
  // a range scan over ai_response_logs on every inbound message.
  period         String
  aiReplies      Int      @default(0) @map("ai_replies")
  inputTokens    BigInt   @default(0) @map("input_tokens")
  outputTokens   BigInt   @default(0) @map("output_tokens")
  // Accumulated provider cost in MICRO-USD (USD × 1_000_000). Integer for
  // the same reason prices are: a per-message cost of $0.0003 is invisible
  // to cents, and rounding it away hides the real margin per customer.
  costMicroUsd   BigInt   @default(0) @map("cost_micro_usd")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, period])
  @@index([period])
  @@map("usage_counters")
}

model Invoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  number         String   @unique // ATL-2026-0001
  status         String   @default("pending") // pending | awaiting_review | paid | rejected | void
  provider       String   @default("manual")
  subtotalHalalas Int     @map("subtotal_halalas")
  // 15% VAT in Saudi Arabia — stored, not derived, so an invoice issued
  // before/after a rate change or before VAT registration stays reproducible
  // exactly as it was sent. Zero is valid and expected below the mandatory
  // registration threshold.
  vatHalalas     Int      @default(0) @map("vat_halalas")
  totalHalalas   Int      @map("total_halalas")
  periodStart    DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime @map("period_end") @db.Timestamptz(6)
  // Manual provider: the customer's transfer reference + uploaded receipt.
  transferRef    String?  @map("transfer_ref")
  receiptUrl     String?  @map("receipt_url")
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote     String?  @map("review_note")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  reviewer     User?        @relation("InvoiceReviewer", fields: [reviewedBy], references: [id])

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("invoices")
}
