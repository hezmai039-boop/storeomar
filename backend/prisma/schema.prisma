/// A visitor on the public landing page asking for a plan.
///
/// This is a LEAD, not a customer: there is no organization, no user, and no
/// session behind it. Self-serve signup is closed (SIGNUP_ENABLED unset), so
/// this table is the intake channel that replaces it — someone picks a plan,
/// leaves contact details, the platform owner arranges payment out of band
/// (bank transfer, WhatsApp), and then activates the plan against a real
/// organization from inside the dashboard.
///
/// organizationId is nullable and stays null until that activation, which is
/// the whole point: a row here grants nothing. Entitlement still comes only
/// from Subscription, so a forged or spammed request costs the platform an
/// inbox line, never a quota.
///
/// No store_id, like the four billing tables above — so it is deliberately
/// absent from prisma/rls.sql. Its isolation is the API layer: every read is
/// behind requirePlatformAdmin(), and the public POST can only insert.
model PlanRequest {
  id             String        @id @default(uuid()) @db.Uuid
  /// Nullable + a denormalised key on purpose. The request records what the
  /// visitor asked for at the moment they asked; deactivating or renaming a
  /// plan later must not rewrite history or orphan the row.
  planId         String?       @map("plan_id") @db.Uuid
  planKey        String        @map("plan_key")
  name           String
  email          String
  phone          String
  storeName      String?       @map("store_name")
  note           String?
  /// new | contacted | activated | rejected
  status         String        @default("new")
  /// Where the lead came from. Only "landing" today; a partner or campaign
  /// page later needs a column, not a new table.
  source         String        @default("landing")
  /// Kept for abuse forensics only — never shown to anyone but platform
  /// staff, and never used to identify a person.
  ip             String?
  /// Set when the owner activates a plan for this lead. Until then the lead
  /// is attached to nothing.
  organizationId String?       @map("organization_id") @db.Uuid
  handledBy      String?       @map("handled_by") @db.Uuid
  handledAt      DateTime?     @map("handled_at") @db.Timestamptz(6)
  handleNote     String?       @map("handle_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  handler        User?         @relation("PlanRequestHandler", fields: [handledBy], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  plan           Plan?         @relation(fields: [planId], references: [id])

  @@index([status, createdAt])
  @@index([email])
  @@map("plan_requests")
}

model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String
  tokenHash String    @unique @map("token_hash")
