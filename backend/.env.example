# انسخ هذا الملف إلى .env ثم عدّل القيم:
#   cp .env.example .env
#
# ملف .env مُستثنى من Git — لا تضع فيه أسرار الإنتاج ثم ترفعه.

# ==========================================================
# مطلوبة — التطبيق لا يقلع بدونها
# ==========================================================

# قاعدة البيانات — الاتصال الذي يستخدمه التطبيق أثناء التشغيل.
#
# اسم القاعدة والأدوار (atlas / atlas_app / atlas_resolver) سابقة لإعادة
# التسمية إلى ميسور، وتبقى كما هي عن قصد: هذه أدوار موجودة فعلًا في قاعدة
# الإنتاج، وأسماؤها مثبّتة في كل GRANT وسياسة RLS مرتبطة بها، وفي
# `docker/init.sql`. راجع docs/32-brand.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas"

# الاتصال المباشر (بلا مجمّع اتصالات) — تستخدمه أوامر Prisma فقط.
#
# ⚠️ إلزامي إذا كانت قاعدتك خلف PgBouncer — وهذا حال **Neon** و**Supabase**
# إن كان رابطك يحتوي `-pooler` أو `pgbouncer=true`.
#
# السبب: الهجرات لا تعمل عبر مجمّع المعاملات. تأخذ أقفال جلسة، وتُصدر أوامر
# DDL متعددة يجب أن تصل كلها إلى نفس الخادم الخلفي. عبر المجمّع تفشل الهجرة —
# أو الأسوأ: تُطبَّق جزئيًا وتُسجَّل كمكتملة.
#
# على Neon: نفس الرابط مع **حذف `-pooler`** من المضيف وحذف `pgbouncer=true`.
#   المجمّع :  ...@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
#   المباشر :  ...@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# على قاعدة محلية بلا مجمّع: اتركه مساويًا لـ DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atlas"

# سرّ توقيع الجلسات (JWT). لا يوجد له قيمة افتراضية عمدًا: قيمة افتراضية
# منشورة في المستودع تعني أن أي شخص يستطيع تزوير جلسة صالحة لأي مستخدم.
# للتطوير المحلي أي نص يكفي. للإنتاج ولّد قيمة عشوائية:
#   openssl rand -base64 32
JWT_SECRET="local-dev-secret-change-me"

# مفتاح تشفير بيانات اعتماد القنوات والتكاملات (توكنات واتساب وسلة وزد).
# يجب أن يكون 32 بايت في الإنتاج. القيم الأقصر تُمدَّد تلقائيًا حتى يقلع
# التطوير المحلي، لكن الإنتاج يحتاج مفتاحًا حقيقيًا:
#   openssl rand -base64 32
#
# ⚠️ تغيير هذا المفتاح بعد تخزين أي بيانات اعتماد يجعلها غير قابلة للفك.
ENCRYPTION_KEY="local-dev-encryption-key-32bytes!"

# ==========================================================
# اختيارية — لها قيم افتراضية آمنة
# ==========================================================

PORT=4000

# اتصال التطبيق أثناء التشغيل. يجب أن يكون دورًا بلا BYPASSRLS حتى يُطبَّق
# عزل الصفوف (RLS) فعليًا على كل طلب. بدونه يرجع إلى DATABASE_URL — وهذا
# مقبول للتطوير فقط، لأن دور الترحيل يتجاوز RLS.
# APP_DATABASE_URL=""
# RESOLVER_DATABASE_URL=""

# عنوان الواجهة المسموح له بمناداة الـ API (CORS).
CORS_ORIGIN="http://localhost:5173"

# عنوان الواجهة كما يظهر في روابط رسائل البريد (التأكيد، استعادة كلمة المرور).
APP_URL="http://localhost:5173"

# --- الذكاء الاصطناعي ---
# بدونه يعمل كل شيء، لكن الردود تعود بنص قاعدة المعرفة حرفيًا بدل صياغة
# طبيعية. أضفه لترى المنتج على حقيقته.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- البريد ---
# console = يطبع الرسالة ورابطها في سجلّ الخادم بدل إرسالها. هذا الافتراضي،
# وهو ما يجعل التسجيل وتأكيد البريد قابلين للاختبار بلا أي حساب خارجي.
EMAIL_PROVIDER="console"
# RESEND_API_KEY=""
# EMAIL_FROM="ميسور <onboarding@maysoor.com>"

# --- التسجيل الذاتي ---
# مغلق افتراضيًا، ولا يُفتح إلا بالقيمة "true" حرفيًا.
#
# السبب مالي: كل منظمة تُنشأ عبر التسجيل تبدأ بباقة مجانية فيها حصة شهرية
# من استدعاءات Anthropic الحقيقية — على مفتاحك أنت. المسار عام وبلا مصادقة،
# فتركه مفتوحًا يعني أن أي شخص يستطيع إنشاء حسابات في حلقة ويستهلك رصيدك.
#
# نسيان فتحه يكلّفك رسالة من عميل. نسيان إغلاقه يكلّفك فاتورة.
# SIGNUP_ENABLED="true"

# --- طلبات الباقات من صفحة الهبوط ---
# البريد الذي يصلك عليه إشعار «شخص طلب باقة». مع إغلاق التسجيل الذاتي أعلاه،
# نموذج صفحة الهبوط هو الطريق الوحيد الذي يصل به عميل جديد إليك.
#
# اختياري: الطابور داخل المنصة (صفحة /billing + العدّاد في الشريط الجانبي)
# هو القناة الأساسية ويعمل دائمًا، والبريد إضافة فوقه. ولاحظ أنه بلا
# EMAIL_PROVIDER حقيقي (resend) لن يُرسَل شيء — المزوّد الافتراضي `console`
# يطبع الرسالة في سجلّ الخادم فقط.
# PLATFORM_NOTIFY_EMAIL=""

# --- الفوترة ---
# بيانات الحساب البنكي التي تُعرض للعميل مع مزوّد الدفع اليدوي.
# BILLING_BANK_NAME=""
# BILLING_ACCOUNT_NAME=""
# BILLING_IBAN=""
#
# ⚠️ اتركها صفرًا حتى تُسجَّل فعليًا في ضريبة القيمة المضافة. إصدار فواتير
# بنسبة 15% قبل التسجيل وبلا رقم تسجيل ضريبي مخالفة نظامية.
BILLING_VAT_PERCENT="0"

# --- واتساب ---
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- سلة وزد (docs/26) ---
# منصة غير مُعدّة تُرجع 503 عند زر الربط؛ التطبيق يقلع بدونها جميعًا.
# SALLA_CLIENT_ID=""
# SALLA_CLIENT_SECRET=""
# ZID_CLIENT_ID=""
# ZID_CLIENT_SECRET=""
# OAUTH_REDIRECT_BASE="http://localhost:4000"

# --- التخزين (docs/28) ---
# local = يكتب على قرص الحاوية، ويفقد الملفات عند إعادة التشغيل. للتطوير فقط.
STORAGE_PROVIDER="local"
# STORAGE_ENDPOINT=""
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
# STORAGE_REGION="auto"

# --- التوسّع والمراقبة ---
# مطلوب فقط عند تشغيل أكثر من نسخة من الخادم (docs/08).
# REDIS_URL=""
# SENTRY_DSN=""
