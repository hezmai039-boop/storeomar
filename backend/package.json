{
  "name": "atlas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=postgresql://test:test@localhost:5432/test JWT_SECRET=test-secret ENCRYPTION_KEY=test-encryption-key-32-bytes-ok tsx --test src/modules/ai-intelligence/__tests__/*.test.ts src/modules/simulation/__tests__/*.test.ts src/modules/knowledge/__tests__/*.test.ts src/modules/identity/__tests__/*.test.ts src/lib/__tests__/*.test.ts src/modules/channels/__tests__/*.test.ts src/modules/integrations/__tests__/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:baseline": "prisma migrate resolve --applied 0_init",
    "db:drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "deploy:db": "npm run prisma:migrate && npm run apply-rls && npm run seed",
    "apply-rls": "tsx prisma/apply-rls.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "rate-limit-redis": "^4.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.11.10",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
